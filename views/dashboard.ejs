<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relatório Comercial</title>
    <link rel="icon" type="image/webp" href="/bali-park-500x500.webp">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --bg-color: #f3f4f6;
            --card-bg: #ffffff;
            --text-primary: #111827;
            --text-secondary: #6b7280;
            --accent-color: #4f46e5; /* Indigo */
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --border-radius: 12px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-primary);
            margin: 0;
            padding: 20px;
            -webkit-font-smoothing: antialiased;
            font-size: 16px; /* Base font size increased */
        }

        .dashboard-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        /* Header */
        header {
            margin-bottom: 30px;
            text-align: center;
        }
        h1 {
            font-size: 2.2rem; /* Increased */
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        p.subtitle {
            color: var(--text-secondary);
            margin-top: 5px;
        }

        /* KPI Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        @media (max-width: 992px) {
            .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 480px) {
            .kpi-grid { grid-template-columns: 1fr; }
        }

        .card {
            background: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .kpi-title {
            font-size: 1rem; /* Increased */
            font-weight: 500;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 8px;
        }
        .kpi-value {
            font-size: 2.2rem; /* Increased */
            font-weight: 700;
            color: var(--text-primary);
            word-break: break-all;
            line-height: 1.2;
        }
        @media (max-width: 480px) {
            .kpi-value {
                font-size: 1.6rem;
            }
        }
        .kpi-value.highlight { color: var(--accent-color); }
        .kpi-value.green { color: var(--success-color); }

        /* Layout Principal */
        .main-grid {
            display: grid;
            grid-template-columns: 2fr 1fr; /* Gráfico maior que a tabela lateral */
            gap: 20px;
            margin-bottom: 30px;
        }
        @media (max-width: 768px) {
            .main-grid { grid-template-columns: 1fr; }
        }

        /* Gráficos e Tabelas */
        .section-title {
            font-size: 1.3rem; /* Increased */
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--text-primary);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }
        th {
            text-align: left;
            padding: 14px; /* Increased padding */
            font-size: 0.9rem; /* Increased */
            text-transform: uppercase;
            color: var(--text-secondary);
            border-bottom: 1px solid #e5e7eb;
        }
        td {
            padding: 14px; /* Increased padding */
            font-size: 1rem; /* Increased */
            border-bottom: 1px solid #f3f4f6;
        }
        tr:last-child td { border-bottom: none; }
        
        .badge {
            background-color: #eef2ff;
            color: var(--accent-color);
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .empty-state {
            text-align: center;
            padding: 20px;
            color: var(--text-secondary);
            font-style: italic;
        }

        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }
    </style>
</head>
<body>

    <div class="dashboard-container">
        <header>
            <h1>Dashboard de Performance</h1>
            <p class="subtitle">Vendas e Efetividade de Atendimento</p>
            
            <div style="margin-top: 20px; display: flex; gap: 15px; justify-content: center; align-items: center; flex-wrap: wrap;">
                <div style="display: flex; gap: 8px; align-items: center;">
                    <label for="dataInicial" style="font-size: 0.9rem; color: var(--text-secondary);">Data Inicial:</label>
                    <input type="date" id="dataInicial" value="<%= dataInicial %>" 
                           style="padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem;">
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <label for="dataFinal" style="font-size: 0.9rem; color: var(--text-secondary);">Data Final:</label>
                    <input type="date" id="dataFinal" value="<%= dataFinal %>" 
                           style="padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem;">
                </div>
                <button onclick="aplicarFiltro()" 
                        style="padding: 8px 20px; background-color: var(--accent-color); color: white; border: none; border-radius: 6px; font-size: 0.9rem; cursor: pointer; font-weight: 500;">
                    Aplicar Filtro
                </button>
                <button onclick="limparFiltro()" 
                        style="padding: 8px 20px; background-color: #6b7280; color: white; border: none; border-radius: 6px; font-size: 0.9rem; cursor: pointer; font-weight: 500;">
                    Mês Atual
                </button>
            </div>
        </header>

        <h2 style="font-size: 1.3rem; font-weight: 600; margin: 30px 0 15px; color: var(--text-primary);">Métricas Leads Site</h2>
        <div class="kpi-grid">
            <div class="card">
                <div class="kpi-title">Faturamento Total</div>
                <div class="kpi-value highlight"><%= kpi.siteFaturamento %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Vendas Totais</div>
                <div class="kpi-value"><%= kpi.siteVendas %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Ticket Médio</div>
                <div class="kpi-value"><%= kpi.siteTicket %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Taxa Interação</div>
                <div class="kpi-value green"><%= kpi.siteTaxaResposta %></div>
                <div style="font-size: 0.8rem; color: #999; margin-top:5px;">
                    interagiram / leads
                </div>
            </div>
        </div>
        <div class="kpi-grid">
            <div class="card">
                <div class="kpi-title">Leads Totais</div>
                <div class="kpi-value"><%= kpi.siteLeads %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Interagiram</div>
                <div class="kpi-value highlight"><%= kpi.siteInteragiram %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Conv. Geral (Vendas/Total)</div>
                <div class="kpi-value highlight"><%= kpi.siteConvGeral %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Conv. Real (Vendas/Interag.)</div>
                <div class="kpi-value green"><%= kpi.siteConvReal %></div>
            </div>
        </div>

        <h2 style="font-size: 1.3rem; font-weight: 600; margin: 30px 0 15px; color: var(--text-primary);">Métricas Anúncio Facebook Ads</h2>
        <div class="kpi-grid">
            <div class="card">
                <div class="kpi-title">Faturamento Total</div>
                <div class="kpi-value highlight"><%= kpi.fbFaturamento %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Vendas Totais</div>
                <div class="kpi-value"><%= kpi.fbVendas %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Ticket Médio</div>
                <div class="kpi-value"><%= kpi.fbTicket %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Taxa Interação</div>
                <div class="kpi-value green"><%= kpi.fbTaxaResposta %></div>
                <div style="font-size: 0.8rem; color: #999; margin-top:5px;">
                    interagiram / leads
                </div>
            </div>
        </div>

        <div class="kpi-grid">
            <div class="card">
                <div class="kpi-title">Leads Anúncio Facebook Ads</div>
                <div class="kpi-value"><%= kpi.fbLeads %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Interagiram</div>
                <div class="kpi-value highlight"><%= kpi.fbInteragiram %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Conv. Geral (Vendas/Total)</div>
                <div class="kpi-value highlight"><%= kpi.fbConvGeral %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Conv. Real (Vendas/Interag.)</div>
                <div class="kpi-value green"><%= kpi.fbConvReal %></div>
            </div>
        </div>

        <div class="main-grid">
            <div class="card">
                <div class="section-title">Evolução de Faturamento</div>
                <div class="chart-container">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>

            <div class="card" style="overflow-x: auto;">
                <div class="section-title">Performance Mensal</div>
                <table>
                    <thead>
                        <tr>
                            <th>Mês</th>
                            <th>Qtd</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%- tables.mensal %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="section-title">
                Últimas 10 Vendas
                <span style="font-size:0.8rem; color:var(--text-secondary); font-weight:400;">Ordenado por data de compra</span>
            </div>
            <table style="width: 100%;">
                <thead>
                    <tr>
                        <th style="width: 30%">Data</th>
                        <th style="width: 40%">Voucher / ID</th>
                        <th style="width: 30%">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    <%- tables.ultimas %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // Configuração do Gráfico usando Chart.js
        const ctx = document.getElementById('revenueChart').getContext('2d');
        
        // Dados injetados pelo EJS
        const labels = <%- charts.labels %>;
        const usersData = <%- charts.users %>;
        const activeUsersData = <%- charts.activeUsers %>;
        const salesData = <%- charts.sales %>;
        const revenueData = <%- charts.revenue %>;

        // Calcular máximos separados para cada eixo
        const maxUsers = Math.max(...usersData, ...activeUsersData);
        const maxSales = Math.max(...salesData);
        const yUsersMax = Math.max(10, Math.ceil(maxUsers * 1.1));
        const ySalesMax = Math.max(6, Math.ceil(maxSales * 1.5));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Vendas',
                        data: salesData,
                        backgroundColor: 'rgba(79, 70, 229, 0.8)',
                        borderColor: '#4f46e5',
                        borderWidth: 1,
                        borderRadius: 4,
                        yAxisID: 'ySales',
                        order: 2
                    },
                    {
                        type: 'line',
                        label: 'Atendimentos Totais',
                        data: usersData,
                        borderColor: '#6b7280',
                        backgroundColor: 'rgba(107, 114, 128, 0.1)',
                        borderWidth: 2,
                        tension: 0.3,
                        pointRadius: 3,
                        yAxisID: 'yUsers',
                        order: 1
                    },
                    {
                        type: 'line',
                        label: 'Que Interagiram',
                        data: activeUsersData,
                        borderColor: '#f59e0b',
                        backgroundColor: 'rgba(245, 158, 11, 0.1)',
                        borderWidth: 2,
                        tension: 0.3,
                        pointRadius: 3,
                        yAxisID: 'yUsers',
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: { position: 'top' },
                    tooltip: {
                        callbacks: {
                            afterBody: function(context) {
                                const index = context[0].dataIndex;
                                const totalUsers = usersData[index];
                                const sales = salesData[index];
                                const revenue = revenueData[index];
                                
                                const valorFormatado = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(revenue);
                                let result = '\nValor: ' + valorFormatado;
                                
                                if (totalUsers > 0) {
                                    const conversionRate = ((sales / totalUsers) * 100).toFixed(2);
                                    result += '\nTaxa de Conversão: ' + conversionRate + '%';
                                } else {
                                    result += '\nTaxa de Conversão: 0.00%';
                                }
                                
                                return result;
                            }
                        }
                    }
                },
                scales: {
                    yUsers: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        beginAtZero: true,
                        max: yUsersMax,
                        grid: { borderDash: [5, 5], color: '#f3f4f6' },
                        title: { display: true, text: 'Atendimentos', color: '#6b7280' },
                        ticks: { color: '#6b7280' }
                    },
                    ySales: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        beginAtZero: true,
                        max: ySalesMax,
                        grid: { display: false },
                        title: { display: true, text: 'Vendas', color: '#4f46e5' },
                        ticks: { 
                            color: '#4f46e5',
                            stepSize: 1
                        }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Funções de filtro de data
        function aplicarFiltro() {
            const dataInicial = document.getElementById('dataInicial').value;
            const dataFinal = document.getElementById('dataFinal').value;
            
            if (!dataInicial || !dataFinal) {
                alert('Por favor, selecione ambas as datas');
                return;
            }
            
            if (dataInicial > dataFinal) {
                alert('A data inicial não pode ser maior que a data final');
                return;
            }
            
            window.location.href = `/?dataInicial=${dataInicial}&dataFinal=${dataFinal}`;
        }

        function limparFiltro() {
            window.location.href = '/';
        }
    </script>
</body>
</html>