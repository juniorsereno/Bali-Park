<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relatório Comercial</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --bg-color: #f3f4f6;
            --card-bg: #ffffff;
            --text-primary: #111827;
            --text-secondary: #6b7280;
            --accent-color: #4f46e5; /* Indigo */
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --border-radius: 12px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-primary);
            margin: 0;
            padding: 20px;
            -webkit-font-smoothing: antialiased;
            font-size: 16px; /* Base font size increased */
        }

        .dashboard-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        /* Header */
        header {
            margin-bottom: 30px;
            text-align: center;
        }
        h1 {
            font-size: 2.2rem; /* Increased */
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        p.subtitle {
            color: var(--text-secondary);
            margin-top: 5px;
        }

        /* KPI Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .kpi-title {
            font-size: 1rem; /* Increased */
            font-weight: 500;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 8px;
        }
        .kpi-value {
            font-size: 2.2rem; /* Increased */
            font-weight: 700;
            color: var(--text-primary);
        }
        .kpi-value.highlight { color: var(--accent-color); }
        .kpi-value.green { color: var(--success-color); }

        /* Layout Principal */
        .main-grid {
            display: grid;
            grid-template-columns: 2fr 1fr; /* Gráfico maior que a tabela lateral */
            gap: 20px;
            margin-bottom: 30px;
        }
        @media (max-width: 768px) {
            .main-grid { grid-template-columns: 1fr; }
        }

        /* Gráficos e Tabelas */
        .section-title {
            font-size: 1.3rem; /* Increased */
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--text-primary);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }
        th {
            text-align: left;
            padding: 14px; /* Increased padding */
            font-size: 0.9rem; /* Increased */
            text-transform: uppercase;
            color: var(--text-secondary);
            border-bottom: 1px solid #e5e7eb;
        }
        td {
            padding: 14px; /* Increased padding */
            font-size: 1rem; /* Increased */
            border-bottom: 1px solid #f3f4f6;
        }
        tr:last-child td { border-bottom: none; }
        
        .badge {
            background-color: #eef2ff;
            color: var(--accent-color);
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .empty-state {
            text-align: center;
            padding: 20px;
            color: var(--text-secondary);
            font-style: italic;
        }

        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }
    </style>
</head>
<body>

    <div class="dashboard-container">
        <header>
            <h1>Dashboard de Performance</h1>
            <p class="subtitle">Vendas e Efetividade de Atendimento</p>
        </header>

        <!-- Top Row Cards -->
        <div class="kpi-grid">
            <div class="card">
                <div class="kpi-title">Faturamento Total</div>
                <div class="kpi-value highlight"><%= kpi.faturamento %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Vendas Totais</div>
                <div class="kpi-value"><%= kpi.vendas %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Ticket Médio</div>
                <div class="kpi-value"><%= kpi.ticket %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Conv. de Resposta</div>
                <div class="kpi-value green"><%= kpi.taxaResposta %></div>
                <div style="font-size: 0.8rem; color: #999; margin-top:5px;">
                    <%= kpi.atendimentoResp %> resp. / <%= kpi.atendimentoTotal %> envios
                </div>
            </div>
        </div>

        <!-- Bottom Row Cards -->
        <div class="kpi-grid">
            <div class="card">
                <div class="kpi-title">Leads Central Vendas</div>
                <div class="kpi-value"><%= kpi.leadsCentralVendas %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Leads Remarketing</div>
                <div class="kpi-value"><%= kpi.leadsRemarketing %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Conv. Geral (Vendas/Total)</div>
                <div class="kpi-value highlight"><%= kpi.convGeral %></div>
            </div>
            <div class="card">
                <div class="kpi-title">Conv. Real (Vendas/Resp)</div>
                <div class="kpi-value green"><%= kpi.convReal %></div>
            </div>
        </div>

        <div class="main-grid">
            <div class="card">
                <div class="section-title">Evolução de Faturamento</div>
                <div class="chart-container">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>

            <div class="card" style="overflow-x: auto;">
                <div class="section-title">Performance Mensal</div>
                <table>
                    <thead>
                        <tr>
                            <th>Mês</th>
                            <th>Qtd</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%- tables.mensal %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="section-title">
                Últimas 10 Vendas
                <span style="font-size:0.8rem; color:var(--text-secondary); font-weight:400;">Ordenado por data de compra</span>
            </div>
            <table style="width: 100%;">
                <thead>
                    <tr>
                        <th style="width: 30%">Data</th>
                        <th style="width: 40%">Voucher / ID</th>
                        <th style="width: 30%">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    <%- tables.ultimas %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // Configuração do Gráfico usando Chart.js
        const ctx = document.getElementById('revenueChart').getContext('2d');
        
        // Dados injetados pelo EJS
        const labels = <%- charts.labels %>;
        const usersData = <%- charts.users %>;
        const activeUsersData = <%- charts.activeUsers %>;
        const salesData = <%- charts.sales %>;

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Usuários Totais',
                        data: usersData,
                        borderColor: '#6b7280', // Gray
                        backgroundColor: 'rgba(107, 114, 128, 0.1)',
                        borderWidth: 2,
                        tension: 0.3,
                        yAxisID: 'y1'
                    },
                    {
                        label: 'Usuários Que Interagiram',
                        data: activeUsersData,
                        borderColor: '#f59e0b', // Amber
                        backgroundColor: 'rgba(245, 158, 11, 0.1)',
                        borderWidth: 2,
                        tension: 0.3,
                        yAxisID: 'y1'
                    },
                    {
                        label: 'Vendas (Qtd)',
                        data: salesData,
                        borderColor: '#4f46e5', // Indigo
                        backgroundColor: 'rgba(79, 70, 229, 0.1)',
                        borderWidth: 2,
                        tension: 0.3,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: { position: 'top' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + context.parsed.y;
                            }
                        }
                    }
                },
                scales: {
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        beginAtZero: true,
                        grid: { borderDash: [5, 5], color: '#f3f4f6' },
                        title: { display: true, text: 'Quantidade' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    </script>
</body>
</html>