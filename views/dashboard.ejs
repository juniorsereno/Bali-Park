<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Performance comercial · Bali Park</title>
  <link rel="stylesheet" href="/assets/dashboard.css">
  <script src="/assets/chart.umd.js" defer></script>
  <script src="/assets/dashboard.js" defer></script>
</head>
<body>
  <%- include('partials/icons') %>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <header class="topbar">
    <a class="brand" href="/" aria-label="Bali Park, início">
      <span class="brand-mark"><img src="/assets/bali-park-logo.webp" alt="" width="46" height="46"></span>
      <span><strong>BALI PARK</strong><small>BABI · AGENTE AI DE VENDAS</small></span>
    </a>
    <div class="topbar-right"><a class="powered-by" href="https://vartana.ia.br" target="_blank" rel="noopener noreferrer" aria-label="Visitar o site da Vartana"><img src="/assets/vartana-logo.svg" alt="Vartana" width="38" height="38"><small>Tecnologia <strong>Vartana</strong></small></a><form action="/logout" method="post"><button class="button button-ghost" type="submit"><svg><use href="#logout"/></svg><span>Sair</span></button></form></div>
  </header>
  <main id="conteudo" class="dashboard">
    <form action="/" method="get" class="filter-bar">
      <div class="filter-title"><span class="icon-box"><svg><use href="#calendar"/></svg></span><div><strong>Período de análise</strong><small>Veja o desempenho da Babi por data</small></div></div>
      <div class="filter-fields">
        <label>De<input type="date" name="dataInicial" value="<%= dataInicial %>" required></label>
        <span class="date-arrow" aria-hidden="true">→</span>
        <label>Até<input type="date" name="dataFinal" value="<%= dataFinal %>" required></label>
        <button class="button button-primary" type="submit"><svg><use href="#filter"/></svg>Aplicar</button>
        <a class="button button-soft" href="/">Mês atual</a>
      </div>
    </form>
    <div class="section-label"><h2>Impacto comercial no período</h2><span>Resultados acompanhados pela Babi</span></div>
    <section class="kpi-grid" aria-label="Indicadores comerciais">
      <article class="metric metric-featured"><div class="metric-top"><span>Faturamento total</span><span class="metric-icon"><svg><use href="#wallet"/></svg></span></div><div class="metric-value"><%= kpi.faturamento %></div><div class="metric-foot"><span class="tiny-dot"></span> Receita acompanhada pela Babi</div></article>
      <article class="metric"><div class="metric-top"><span>Vendas realizadas</span><span class="metric-icon blue"><svg><use href="#ticket"/></svg></span></div><div class="metric-value"><%= number(kpi.vendas) %></div><div class="metric-foot">Conversas que avançaram para resultados</div></article>
      <article class="metric"><div class="metric-top"><span>Ticket médio</span><span class="metric-icon mint"><svg><use href="#wallet"/></svg></span></div><div class="metric-value"><%= kpi.ticket %></div><div class="metric-foot">Valor médio dos resultados gerados</div></article>
      <article class="metric"><div class="metric-top"><span>Taxa de resposta</span><span class="metric-icon amber"><svg><use href="#chat"/></svg></span></div><div class="metric-value"><%= kpi.taxaResposta %></div><div class="metric-foot"><strong><%= number(kpi.atendimentoResp) %></strong> respostas · <%= number(kpi.atendimentoTotal) %> atendimentos</div></article>
    </section>
    <section class="secondary-grid" aria-label="Leads e conversões">
      <article class="mini-metric"><span class="mini-icon"><svg><use href="#users"/></svg></span><div><span>Leads central de vendas</span><strong><%= number(kpi.leadsCentralVendas) %></strong></div></article>
      <article class="mini-metric"><span class="mini-icon"><svg><use href="#return"/></svg></span><div><span>Leads remarketing</span><strong><%= number(kpi.leadsRemarketing) %></strong></div></article>
      <article class="mini-metric"><span class="mini-icon"><svg><use href="#trend"/></svg></span><div><span>Conversão geral</span><strong><%= kpi.convGeral %></strong><small>Vendas / atendimentos</small></div></article>
      <article class="mini-metric"><span class="mini-icon"><svg><use href="#target"/></svg></span><div><span>Conversão real</span><strong><%= kpi.convReal %></strong><small>Vendas / respostas</small></div></article>
    </section>
    <section class="performance-grid" aria-label="Vendas e histórico mensal">
      <article class="panel activity-panel"><div class="panel-heading"><div><h2>Vendas e atendimento</h2><p id="activity-chart-description">Como as conversas da Babi avançam até a venda</p></div><div class="chart-toggle" role="group" aria-label="Visualização do gráfico"><button class="active" type="button" data-chart-view="daily" aria-pressed="true">Vendas por dia</button><button type="button" data-chart-view="hourly" aria-pressed="false">Vendas por horário</button></div></div><div class="chart-wrap"><canvas id="activityChart" role="img" aria-label="Gráfico de vendas e atendimentos por dia"></canvas></div></article>
      <article class="panel monthly-panel"><div class="panel-heading"><div><h2>Performance mensal</h2><p>Histórico geral de vendas</p></div><svg class="subtle-icon"><use href="#calendar"/></svg></div><div class="table-scroll"><table><thead><tr><th>Mês</th><th>Vendas</th><th class="align-right">Faturamento</th></tr></thead><tbody><% tables.mensal.forEach(row => { %><tr><td class="strong"><%= row.mes %></td><td><span class="count-badge"><%= number(row.qtd) %></span></td><td class="align-right strong"><%= money(row.total) %></td></tr><% }) %><% if (!tables.mensal.length) { %><tr><td colspan="3" class="empty-state">Ainda não há vendas para exibir.</td></tr><% } %></tbody></table></div></article>
    </section>
    <section class="latest-sales" aria-label="Últimas vendas">
      <article class="panel sales-panel"><div class="panel-heading"><div><h2>Últimas vendas</h2><p>As 10 vendas mais recentes · histórico geral</p></div><span class="badge">Pagamentos aprovados</span></div><div class="table-scroll"><table><thead><tr><th>Voucher</th><th>Data e hora</th><th>Status</th><th class="align-right">Valor</th></tr></thead><tbody><% tables.ultimas.forEach(row => { %><tr><td><span class="voucher"><svg><use href="#ticket"/></svg><%= row.voucher_code || '—' %></span><small class="row-id">#<%= row.id %></small></td><td><span><%= row.data_compra %></span><small class="row-time"><%= row.hora_compra %></small></td><td><span class="paid-badge"><span></span>Aprovado</span></td><td class="align-right strong"><%= money(row.valor_total) %></td></tr><% }) %><% if (!tables.ultimas.length) { %><tr><td colspan="4" class="empty-state">As próximas vendas aparecerão aqui.</td></tr><% } %></tbody></table></div></article>
    </section>
    <footer class="footer"><span><strong>CRIATIVA AI</strong> · Inteligência que transforma conversas em resultados.</span><span>Babi para Bali Park · Valores em reais · Horário de Brasília</span></footer>
  </main>
  <script id="chart-data" type="application/json"><%- chartJson %></script>
</body>
</html>
